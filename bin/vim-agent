#!/usr/bin/env bash
# vim-agent: 把一段代码/问题非交互地丢给 codex 或 claude,结果输出到 stdout
#
# 用法:
#   vim-agent codex  [prompt]     # 没有 prompt 时从 stdin 读
#   vim-agent claude [prompt]
#
# claude 需要的 ANTHROPIC_* / 代理环境变量放在 ~/.config/vim-agent/env.sh(600),
# 不走 shell 里的 alias —— Vim 的 job 起的是非交互 shell,不认 alias。
set -euo pipefail

if [ -f "$HOME/.config/vim-agent/env.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.config/vim-agent/env.sh"
fi

agent="${1:-}"
shift || true

case "$agent" in
  codex|claude) ;;
  *)
    echo "usage: vim-agent <codex|claude> [prompt]" >&2
    exit 2
    ;;
esac

if [ "$#" -gt 0 ]; then
  prompt="$*"
else
  prompt="$(cat)"
fi

if [ -z "${prompt//[[:space:]]/}" ]; then
  echo "vim-agent: empty prompt" >&2
  exit 2
fi

case "$agent" in
  codex)
    # -s read-only: 只允许读,不许改文件; -C: 让 agent 以当前项目为工作目录
    exec codex exec --skip-git-repo-check -s read-only -C "${VIM_AGENT_CWD:-$PWD}" "$prompt"
    ;;
  claude)
    # -p 非交互输出; 只放开读类工具,避免它自己动文件
    exec claude -p "$prompt" --allowedTools "Read Grep Glob"
    ;;
esac
